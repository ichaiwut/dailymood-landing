---
import type { ImageMetadata } from 'astro';
import Sticker from './Sticker.astro';
import PhoneShot from './PhoneShot.astro';

type FaceKind = 'great' | 'good' | 'okay' | 'meh' | 'bad' | 'awful' | 'calm';

interface Props {
  id: string;
  /** Text on the right, phone on the left. */
  reverse?: boolean;
  eyebrow: string;
  title: string;
  sub: string;
  bullets: { ic: string; t: string }[];
  img: ImageMetadata;
  alt: string;
  /** Bullet icon-chip colours + blob colour behind the phone. */
  accent: { bg: string; fg: string; blob: string };
  /** Phone rotation in degrees. */
  rot?: number;
  /** Floating mood sticker: face + a CSS position string (incl. --r). */
  sticker?: { face: FaceKind; pos: string };
  /** Floating chip: text + rotation (e.g. "-7deg") + a CSS position string. */
  chip?: { txt: string; rot: string; pos: string };
  /** Section background (defaults to transparent desk). */
  bg?: string;
}
const {
  id,
  reverse = false,
  eyebrow,
  title,
  sub,
  bullets,
  img,
  alt,
  accent,
  rot = -1.5,
  sticker,
  chip,
  bg = 'transparent',
} = Astro.props;

const cols = reverse ? '1fr 1.05fr' : '1.05fr 1fr';
---

<section id={id} class="section" style={`background:${bg};position:relative;overflow:hidden`}>
  <div
    class={`container grid-2 spotlight reveal${reverse ? ' rev' : ''}`}
    style={`display:grid;grid-template-columns:${cols};gap:64px;align-items:center`}
  >
    <div class="sp-text">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="h-display" style="font-size:clamp(30px, 4.2vw, 52px);margin:18px 0 16px">
        {title}
      </h2>
      <p style="font-size:18px;color:var(--ink-2);max-width:460px;margin:0">{sub}</p>
      <ul style="list-style:none;padding:0;margin:24px 0 0;display:flex;flex-direction:column;gap:13px">
        {
          bullets.map((b) => (
            <li style="display:flex;gap:12px;align-items:flex-start;font-size:16px;font-weight:600;color:var(--ink)">
              <span
                aria-hidden="true"
                style={`flex-shrink:0;width:26px;height:26px;border-radius:9px;background:${accent.bg};color:${accent.fg};display:grid;place-items:center;font-size:15px`}
              >
                {b.ic}
              </span>
              <span>{b.t}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="sp-media" style="position:relative;display:grid;place-items:center">
      <div
        aria-hidden="true"
        style={`position:absolute;border-radius:50%;filter:blur(46px);opacity:.55;background:${accent.blob};width:340px;height:340px;inset:0;margin:auto`}
      >
      </div>
      {sticker && <Sticker face={sticker.face} color="#fff" size={54} class="floaty" style={sticker.pos} />}
      {
        chip && (
          <div
            class="chip floaty"
            style={`position:absolute;z-index:9;--r:${chip.rot};transform:rotate(${chip.rot});animation-delay:.7s;${chip.pos}`}
          >
            {chip.txt}
          </div>
        )
      }
      <PhoneShot src={img} alt={alt} w={318} style={`position:relative;z-index:5;transform:rotate(${rot}deg)`} />
    </div>
  </div>
</section>

<style>
  /* Desktop: when reversed, text moves right and the phone left. */
  .spotlight.rev .sp-text {
    order: 2;
  }
  .spotlight.rev .sp-media {
    order: 1;
  }
  /* Mobile (single column): always text first, phone second — DOM order. */
  @media (max-width: 980px) {
    .spotlight .sp-text,
    .spotlight .sp-media {
      order: 0 !important;
    }
  }
</style>
