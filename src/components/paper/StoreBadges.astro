---
import { type Locale, getMessages } from '@/lib/i18n';
import { appStoreHref, playStoreHref, isAndroidLive } from '@/lib/cta';

interface Props {
  locale: Locale;
  /** Badge size. */
  size?: 'lg' | 'sm';
  /** Where on the page these badges sit — sent with the GA download_click event. */
  location: string;
  /** Justify the row (e.g. "center" for the CTA banner). */
  justify?: string;
}
const { locale, size = 'lg', location, justify = 'flex-start' } = Astro.props;
const s = getMessages(locale).landing.store;
const big = size === 'lg';
const h = big ? 58 : 52;
const pad = big ? '0 20px 0 16px' : '0 16px 0 13px';
const nameSize = big ? 19 : 17;
const appleSize = big ? 26 : 23;
const playSize = big ? 24 : 21;

const badgeStyle = `display:inline-flex;align-items:center;gap:11px;height:${h}px;padding:${pad};border-radius:14px;background:var(--ink);color:#fff;text-decoration:none;box-shadow:0 8px 0 -2px #000,0 16px 28px -16px rgba(0,0,0,.6)`;
const labelStyle =
  'font-size:10.5px;font-weight:700;letter-spacing:.04em;opacity:.78;line-height:1;text-transform:uppercase';
const nameStyle = `font-size:${nameSize}px;font-weight:800;letter-spacing:-.01em;line-height:1.05;margin-top:3px`;

// Android isn't published yet → the Google Play badge renders greyed-out and
// non-clickable (a <span>, with no GA tracking attributes) and a "coming soon"
// hint sits below the row. Set PUBLIC_ANDROID_URL to flip it live — no code change.
const androidLive = isAndroidLive();
const PlayTag = androidLive ? 'a' : 'span';
const playProps = androidLive
  ? {
      href: playStoreHref(),
      'data-store': 'android',
      'data-dl-loc': location,
      'aria-label': `${s.playLabel} Google Play`,
    }
  : {
      'aria-disabled': 'true',
      'aria-label': `Google Play — ${s.androidSoon}`,
      // Not a real download link, but a tap = "I want Android" → tracked as an
      // android_interest event by the delegated listener in LandingPage.astro.
      'data-android-soon': '',
      'data-dl-loc': location,
    };
const hintAlign = justify === 'center' ? 'center' : justify === 'flex-end' ? 'right' : 'left';
---

<div class="store-badges-wrap" style="display:flex;flex-direction:column;gap:9px">
  <div
    class="store-badges"
    style={`display:flex;gap:14px;flex-wrap:wrap;justify-content:${justify}`}
  >
    <a
      href={appStoreHref()}
      class="storebadge"
      data-store="ios"
      data-dl-loc={location}
      aria-label={`${s.appStoreLabel} App Store`}
      style={badgeStyle}
    >
      <svg
        width={appleSize}
        height={appleSize}
        viewBox="0 0 384 512"
        fill="currentColor"
        aria-hidden="true"
        style="display:block"
      >
        <path
          d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"
        ></path>
      </svg>
      <span style="display:flex;flex-direction:column">
        <span style={labelStyle}>{s.appStoreLabel}</span>
        <span style={nameStyle}>App Store</span>
      </span>
    </a>

    <PlayTag
      class:list={['storebadge', { 'is-disabled': !androidLive }]}
      style={badgeStyle}
      {...playProps}
    >
      <svg
        width={playSize}
        height={playSize}
        viewBox="0 0 40 44"
        aria-hidden="true"
        style="display:block"
      >
        <path d="M3.4 1.9 22.6 21 3.4 40.1c-.5-.3-.84-.86-.84-1.6V3.5c0-.74.34-1.3.84-1.6z" fill="#00D2FF"
        ></path>
        <path d="M3.4 1.9c.18-.1.38-.16.6-.16.32 0 .65.1.95.28L28.3 15.6l-5.7 5.4z" fill="#00F076"></path>
        <path d="M22.6 21l5.7 5.4-22.35 12.96c-.3.18-.63.28-.95.28-.22 0-.42-.06-.6-.16z" fill="#FF3A44"
        ></path>
        <path d="M28.3 15.6 35 19.5c.78.45 1.18 1.05 1.18 1.6 0 .55-.4 1.15-1.18 1.6l-6.7 3.7-5.7-5.4z" fill="#FFC900"
        ></path>
      </svg>
      <span style="display:flex;flex-direction:column">
        <span style={labelStyle}>{s.playLabel}</span>
        <span style={nameStyle}>Google Play</span>
      </span>
    </PlayTag>
  </div>

  {
    !androidLive && (
      <p class="android-soon" style={`text-align:${hintAlign}`}>
        <span class="android-soon-inner">
          <span class="android-soon-dot" aria-hidden="true" />
          {s.androidSoon}
        </span>
      </p>
    )
  }
</div>

<style>
  .storebadge {
    transition:
      transform 0.14s ease,
      box-shadow 0.2s ease;
  }
  .storebadge:hover {
    transform: translateY(-2px);
    box-shadow:
      0 10px 0 -2px #000,
      0 20px 32px -16px rgba(0, 0, 0, 0.65) !important;
  }
  .storebadge:active {
    transform: translateY(0);
  }

  /* Android not published yet: muted and flat, but still tappable so a click
     registers as an "I want Android" interest signal. */
  .storebadge.is-disabled {
    opacity: 0.4;
    filter: grayscale(1);
    cursor: pointer;
    box-shadow:
      0 4px 0 -2px #000,
      0 8px 16px -12px rgba(0, 0, 0, 0.45) !important;
  }
  .storebadge.is-disabled:hover {
    transform: none;
    box-shadow:
      0 4px 0 -2px #000,
      0 8px 16px -12px rgba(0, 0, 0, 0.45) !important;
  }

  .android-soon {
    margin: 0;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--ink-3);
  }
  .android-soon-inner {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .android-soon-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--peach);
    box-shadow: 0 0 0 3px rgba(252, 164, 91, 0.22);
  }
</style>
