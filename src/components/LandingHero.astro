---
import CheckCircle from './CheckCircle.astro';
import Sticker from './paper/Sticker.astro';
import PhoneShot from './paper/PhoneShot.astro';
import StoreBadges from './paper/StoreBadges.astro';
import heroImg from '@/assets/app/app-01-home.png';
import { type Locale, getMessages } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const h = getMessages(locale).landing.hero;
---

<section id="top" style="position:relative;overflow:hidden;padding-top:40px;padding-bottom:90px">
  <div
    class="container hero-grid"
    style="position:relative;display:grid;grid-template-columns:1.04fr 1fr;gap:54px;align-items:center"
  >
    <div>
      <span class="eyebrow">{h.eyebrow}</span>
      <h1 class="h-display" style="font-size:clamp(40px, 6.2vw, 80px);margin:22px 0 22px">
        {h.h1a}<br />
        {h.h1b}{' '}
        <span class="mark">{h.h1c}</span>
      </h1>
      <p style="font-size:19px;color:var(--ink-2);max-width:500px;margin-bottom:28px;font-weight:500">
        {h.sub}
      </p>

      <!-- primary action -->
      <StoreBadges locale={locale} size="lg" location="hero" />

      <!-- trust row -->
      <div style="display:flex;gap:18px;margin-top:24px;flex-wrap:wrap;align-items:center">
        {
          [h.trust1, h.trust2, h.trust3].map((tx) => (
            <span style="display:flex;align-items:center;gap:7px;font-size:13.5px;font-weight:700;color:var(--ink-2)">
              <CheckCircle /> {tx}
            </span>
          ))
        }
      </div>
    </div>

    <!-- hero phone -->
    <div style="position:relative;display:grid;place-items:center">
      <div
        aria-hidden="true"
        style="position:absolute;border-radius:50%;filter:blur(46px);opacity:.55;background:var(--peach);width:330px;height:330px;top:-10px;right:30px"
      >
      </div>
      <div
        aria-hidden="true"
        style="position:absolute;border-radius:50%;filter:blur(46px);opacity:.6;background:var(--lavender);width:300px;height:300px;bottom:0;left:10px"
      >
      </div>
      <Sticker
        face="great"
        color="#fff"
        size={58}
        class="floaty"
        style="bottom:64px;right:4%;--r:10deg;animation-delay:.4s;z-index:9"
      />
      <div
        class="chip floaty"
        style="position:absolute;top:90px;left:2%;z-index:9;--r:-8deg;transform:rotate(-8deg);animation-delay:.9s"
      >
        {h.chipStreak}
      </div>
      <PhoneShot
        src={heroImg}
        alt="DailyMood — today screen"
        w={340}
        eager
        style="position:relative;z-index:5;transform:rotate(1.4deg)"
      />
    </div>
  </div>
</section>
