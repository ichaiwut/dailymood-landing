---
import { type Locale, getMessages } from '@/lib/i18n';
import { guestAnalyzeUrl, loginWithGuestEntry } from '@/lib/cta';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const w = getMessages(locale).landing.heroWidget;

// The 7 system moods, in the app's display order. Faces are the same R2 SVGs the
// app and the result card use, so the picker and the result icon stay identical.
const R2_MOOD_BASE = 'https://pub-f0f688a68f884179942645789862cf54.r2.dev/set_486038';
const MOOD_IDS = ['amazing', 'happy', 'neutral', 'sad', 'angry', 'anxious', 'tired'] as const;
const moods = MOOD_IDS.map((id) => ({
  id,
  label: w.moods[id],
  iconUrl: `${R2_MOOD_BASE}/${id}.svg`,
}));

const analyzeUrl = guestAnalyzeUrl();
// Template the login URL; the script swaps __TOKEN__ for the parked-result token.
const loginTemplate = loginWithGuestEntry('__TOKEN__');

// Cloudflare Turnstile (anti-bot). When unset, the widget + script are not
// rendered and no token is sent — the endpoint then runs without the bot check.
const turnstileSiteKey = (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined) ?? '';
---

<div
  class="hw"
  id="hw-widget"
  data-state="idle"
  data-analyze-url={analyzeUrl}
  data-login-template={loginTemplate}
  data-loading={JSON.stringify(w.loading)}
  data-turnstile-key={turnstileSiteKey}
>
  <!-- ── Idle / input ── -->
  <div class="hw-pane hw-idle">
    <span class="eyebrow"><span class="dot"></span> {w.eyebrow}</span>
    <h3 class="hw-title">{w.title}</h3>
    <span class="hw-mood-label">{w.moodLabel}</span>
    <div class="hw-moods" role="group" aria-label={w.moodLabel}>
      {
        moods.map((mm) => (
          <button type="button" class="hw-mood" data-mood={mm.id} aria-pressed="false" title={mm.label}>
            <img src={mm.iconUrl} alt="" width="38" height="38" loading="lazy" />
            <span class="hw-mood-name">{mm.label}</span>
          </button>
        ))
      }
    </div>
    <textarea
      class="hw-input"
      rows="3"
      maxlength="300"
      placeholder={w.placeholder}
      aria-label={w.title}
    ></textarea>
    <div class="hw-meta">
      <span
        class="hw-error"
        role="alert"
        data-short={w.errShort}
        data-long={w.errLong}
        data-rate={w.errRate}
        data-generic={w.errGeneric}
        data-captcha={w.errCaptcha}
        data-busy={w.errBusy}
      ></span>
      <span class="hw-count">0 / 300</span>
    </div>
    {turnstileSiteKey && <div class="hw-turnstile" data-sitekey={turnstileSiteKey}></div>}
    <button type="button" class="btn btn-peach hw-analyze">{w.analyzeCta}</button>
  </div>

  <!-- ── Loading ── -->
  <div class="hw-pane hw-loading">
    <div class="hw-spinner" aria-hidden="true"></div>
    <p class="hw-loading-text" aria-live="polite">{w.analyzing}</p>
  </div>

  <!-- ── Result ── -->
  <div class="hw-pane hw-result">
    <div class="hw-said">
      <span class="hw-said-label">{w.youWrote}</span>
      <p class="hw-said-text"></p>
    </div>
    <div class="hw-card">
      <div class="hw-icon-wrap">
        <img class="hw-icon" alt="" width="56" height="56" />
        <span class="hw-icon-fallback" aria-hidden="true" hidden>🙂</span>
      </div>
      <span class="hw-result-eyebrow">{w.resultEyebrow}</span>
      <p class="hw-summary"></p>
      <div class="hw-tags"></div>
    </div>
    <p class="hw-save-hint">{w.saveHint}</p>
    <a class="btn hw-save" href="#">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" style="flex:none">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
      </svg>
      {w.saveCta}
    </a>
    <button type="button" class="hw-again">{w.tryAgain}</button>
  </div>
</div>

{
  turnstileSiteKey && (
    <script is:inline async src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>
  )
}

<style>
  .hw {
    background: #fff;
    border-radius: 24px;
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 0 40px 80px -20px rgba(70, 32, 100, 0.25), 0 20px 40px -20px rgba(0, 0, 0, 0.15);
    padding: 28px;
  }
  .hw-pane { animation: hw-fade 0.45s ease both; }
  .hw-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin: 14px 0 16px;
  }
  .hw-mood-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-2);
    margin-bottom: 10px;
  }
  .hw-moods {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }
  .hw-mood {
    flex: 1 1 auto;
    min-width: 62px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    padding: 9px 4px;
    border-radius: 14px;
    border: 1.5px solid var(--rule);
    background: var(--page);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, transform 0.1s;
  }
  .hw-mood:hover { border-color: var(--lavender); }
  .hw-mood:active { transform: scale(0.96); }
  .hw-mood img { display: block; pointer-events: none; }
  .hw-mood-name {
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-2);
    line-height: 1;
  }
  .hw-mood[aria-pressed='true'] {
    border-color: var(--purple);
    background: var(--lavender-light);
  }
  .hw-mood[aria-pressed='true'] .hw-mood-name { color: var(--purple-strong); }
  .hw-turnstile { margin: 0 0 14px; min-height: 1px; }
  .hw-turnstile:empty { display: none; }
  .hw-input {
    width: 100%;
    box-sizing: border-box;
    resize: none;
    overflow: hidden;
    min-height: 96px;
    padding: 16px;
    border-radius: 16px;
    border: 1.5px solid var(--rule);
    background: var(--page);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink);
    transition: border-color 0.2s;
  }
  .hw-input:focus { outline: none; border-color: var(--purple); }
  .hw-input::placeholder { color: var(--ink-3); }
  .hw-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin: 8px 2px 16px;
    min-height: 18px;
  }
  .hw-error { font-size: 13px; font-weight: 600; color: #d14343; }
  .hw-count { font-size: 12px; color: var(--ink-3); margin-left: auto; flex: none; }
  .hw-analyze {
    width: 100%;
    height: 56px;
    font-size: 16px;
    position: relative;
  }
  .hw-analyze:not(:disabled):hover {
    box-shadow: 0 0 0 4px rgba(252, 164, 91, 0.25), 0 14px 28px -8px rgba(252, 164, 91, 0.6);
  }
  .hw-analyze:disabled { opacity: 0.55; cursor: default; }

  /* loading */
  .hw-loading { text-align: center; padding: 40px 12px; }
  .hw-spinner {
    width: 44px;
    height: 44px;
    margin: 0 auto 18px;
    border-radius: 50%;
    border: 3px solid var(--lavender);
    border-top-color: var(--purple);
    animation: hw-spin 0.8s linear infinite;
  }
  .hw-loading-text { font-size: 15px; font-weight: 600; color: var(--ink-2); }

  /* result */
  .hw-said {
    background: var(--page);
    border: 1px solid var(--rule);
    border-radius: 16px;
    padding: 14px 16px;
    margin-bottom: 14px;
  }
  .hw-said-label {
    display: block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 6px;
  }
  .hw-said-text {
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .hw-card {
    border-radius: 20px;
    padding: 26px 22px;
    color: #fff;
    text-align: center;
    background: var(--lavender);
  }
  .hw-icon-wrap {
    width: 76px;
    height: 76px;
    margin: 0 auto 14px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.25);
  }
  .hw-icon-fallback { font-size: 36px; }
  .hw-result-eyebrow {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .hw-summary {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.45;
    margin: 8px 0 14px;
  }
  .hw-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }
  .hw-tag {
    font-size: 12px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.22);
  }
  .hw-save-hint {
    text-align: center;
    font-size: 14px;
    color: var(--ink-2);
    margin: 18px 0 12px;
  }
  .hw-save {
    width: 100%;
    height: 56px;
    font-size: 16px;
    gap: 10px;
    background: var(--ink);
    color: #fff;
  }
  .hw-save:hover { background: #2a1f33; transform: translateY(-1px); }
  .hw-again {
    display: block;
    margin: 8px auto 0;
    padding: 12px 16px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-3);
    text-decoration: underline;
  }

  .hw[data-state='idle'] .hw-loading,
  .hw[data-state='idle'] .hw-result,
  .hw[data-state='loading'] .hw-idle,
  .hw[data-state='loading'] .hw-result,
  .hw[data-state='result'] .hw-idle,
  .hw[data-state='result'] .hw-loading { display: none; }

  @keyframes hw-spin { to { transform: rotate(360deg); } }
  @keyframes hw-fade {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hw-pane { animation: none; }
    .hw-spinner { animation-duration: 1.6s; }
  }
</style>

<script>
  const hwEl = document.getElementById('hw-widget') as HTMLElement | null;
  if (hwEl) {
    const root: HTMLElement = hwEl;
    const analyzeUrl = root.dataset.analyzeUrl as string;
    const loginTemplate = root.dataset.loginTemplate as string;
    const loadingMsgs = JSON.parse(root.dataset.loading || '[]') as string[];

    const input = root.querySelector('.hw-input') as HTMLTextAreaElement;
    const count = root.querySelector('.hw-count') as HTMLElement;
    const errEl = root.querySelector('.hw-error') as HTMLElement;
    const analyzeBtn = root.querySelector('.hw-analyze') as HTMLButtonElement;
    const loadingText = root.querySelector('.hw-loading-text') as HTMLElement;
    const card = root.querySelector('.hw-card') as HTMLElement;
    const saidText = root.querySelector('.hw-said-text') as HTMLElement;
    const icon = root.querySelector('.hw-icon') as HTMLImageElement;
    const iconFallback = root.querySelector('.hw-icon-fallback') as HTMLElement;
    const summaryEl = root.querySelector('.hw-summary') as HTMLElement;
    const tagsEl = root.querySelector('.hw-tags') as HTMLElement;
    const saveLink = root.querySelector('.hw-save') as HTMLAnchorElement;
    const againBtn = root.querySelector('.hw-again') as HTMLButtonElement;
    const moodBtns = root.querySelectorAll('.hw-mood') as NodeListOf<HTMLButtonElement>;

    // i18n error strings are rendered server-side into the .hw-error data-* attrs.
    let rotateTimer = 0;
    // The mood the user tapped (optional). Sent to the API, where it overrides
    // the AI's own guess; empty means "let the AI decide", the original behaviour.
    let selectedMood = '';

    function clearMood() {
      selectedMood = '';
      moodBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
    }

    moodBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.mood || '';
        if (selectedMood === id) {
          clearMood(); // tap the active mood again to deselect
          return;
        }
        selectedMood = id;
        moodBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      });
    });

    // ── Cloudflare Turnstile (anti-bot) ──
    // Only active when PUBLIC_TURNSTILE_SITE_KEY is set (holder rendered + key
    // present). The token proves a human; it's single-use, so we reset the widget
    // after every attempt to mint a fresh one for the next analyze.
    const turnstileKey = root.dataset.turnstileKey || '';
    const tsHolder = root.querySelector('.hw-turnstile') as HTMLElement | null;
    const turnstileOn = !!turnstileKey && !!tsHolder;
    let tsWidgetId: string | undefined;
    let tsToken = '';

    function getTurnstile(): any {
      return (window as unknown as { turnstile?: any }).turnstile;
    }

    function renderTurnstile() {
      const ts = getTurnstile();
      if (!ts || !tsHolder || tsWidgetId !== undefined) return;
      tsWidgetId = ts.render(tsHolder, {
        sitekey: turnstileKey,
        callback: (t: string) => { tsToken = t; },
        'error-callback': () => { tsToken = ''; },
        'expired-callback': () => { tsToken = ''; },
        theme: 'light',
      });
    }

    function resetTurnstile() {
      tsToken = '';
      const ts = getTurnstile();
      if (ts && tsWidgetId !== undefined) ts.reset(tsWidgetId);
    }

    if (turnstileOn) {
      // The api.js script loads async; render as soon as it's available.
      if (getTurnstile()) renderTurnstile();
      else {
        const iv = window.setInterval(() => {
          if (getTurnstile()) { window.clearInterval(iv); renderTurnstile(); }
        }, 200);
        window.setTimeout(() => window.clearInterval(iv), 10000);
      }
    }

    function setError(msg: string) {
      errEl.textContent = msg;
    }

    function autosize() {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 260) + 'px';
    }

    input.addEventListener('input', () => {
      autosize();
      count.textContent = input.value.length + ' / 300';
      if (errEl.textContent) setError('');
    });

    function stopRotate() {
      if (rotateTimer) { clearInterval(rotateTimer); rotateTimer = 0; }
    }

    function startRotate() {
      if (!loadingMsgs.length) return;
      let i = 0;
      loadingText.textContent = loadingMsgs[0];
      rotateTimer = window.setInterval(() => {
        i = (i + 1) % loadingMsgs.length;
        loadingText.textContent = loadingMsgs[i];
      }, 1800);
    }

    async function analyze() {
      const text = input.value.trim();
      if (text.length < 5) { setError(errEl.dataset.short || ''); return; }
      if (text.length > 300) { setError(errEl.dataset.long || ''); return; }
      if (turnstileOn && !tsToken) { setError(errEl.dataset.captcha || errEl.dataset.generic || ''); return; }
      setError('');
      analyzeBtn.disabled = true;
      root.dataset.state = 'loading';
      startRotate();

      try {
        const payload: { text: string; mood?: string; turnstileToken?: string } = { text };
        if (selectedMood) payload.mood = selectedMood;
        if (turnstileOn) payload.turnstileToken = tsToken;
        const res = await fetch(analyzeUrl, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => null);
        stopRotate();
        analyzeBtn.disabled = false;

        if (!res.ok || !data) {
          root.dataset.state = 'idle';
          if (res.status === 429) setError(errEl.dataset.rate || '');
          else if (res.status === 503 || (data && data.error === 'busy')) setError(errEl.dataset.busy || errEl.dataset.generic || '');
          else if (data && data.error === 'captcha') setError(errEl.dataset.captcha || errEl.dataset.generic || '');
          else if (data && data.error === 'too_short') setError(errEl.dataset.short || '');
          else if (data && data.error === 'too_long') setError(errEl.dataset.long || '');
          else setError(errEl.dataset.generic || '');
          resetTurnstile(); // the token was consumed by this attempt
          return;
        }

        resetTurnstile(); // success — refresh the token for any later attempt
        saidText.textContent = text;
        card.style.background = data.gradient || 'var(--lavender)';
        // Reset icon state each cycle so a prior result's icon never lingers.
        icon.hidden = true;
        iconFallback.hidden = false;
        icon.removeAttribute('src');
        if (data.iconUrl) {
          icon.src = data.iconUrl;
          icon.hidden = false;
          iconFallback.hidden = true;
        }
        summaryEl.textContent = data.summary || '';
        tagsEl.innerHTML = '';
        (data.tags || []).forEach((t: string) => {
          const chip = document.createElement('span');
          chip.className = 'hw-tag';
          chip.textContent = '#' + t;
          tagsEl.appendChild(chip);
        });
        saveLink.href = data.token
          ? loginTemplate.replace('__TOKEN__', encodeURIComponent(data.token))
          : loginTemplate.replace('?guestEntry=__TOKEN__', '');
        root.dataset.state = 'result';
      } catch {
        stopRotate();
        analyzeBtn.disabled = false;
        root.dataset.state = 'idle';
        setError(errEl.dataset.generic || '');
        resetTurnstile();
      }
    }

    icon.addEventListener('error', () => {
      icon.hidden = true;
      iconFallback.hidden = false;
    });

    analyzeBtn.addEventListener('click', analyze);
    againBtn.addEventListener('click', () => {
      root.dataset.state = 'idle';
      clearMood();
      input.focus();
    });
  }
</script>
