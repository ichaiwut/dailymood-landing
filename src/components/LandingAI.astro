---
import Folder from './paper/Folder.astro';
import Paperclip from './paper/Paperclip.astro';
import PhoneShot from './paper/PhoneShot.astro';
import reflectImg from '@/assets/app/app-03-ai-reflect.png';
import { type Locale, getMessages } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const a = getMessages(locale).landing.ai;
const modes = a.modes as { tag: string; d: string }[];
const modeColors = ['var(--peach)', 'var(--mint)', 'var(--lavender)'];
---

<section id="ai" class="section">
  <div class="container reveal">
    <Folder
      tabClass="peach"
      sheetClass="plum"
      bodyStyle="padding:52px 48px;border-radius:4px 26px 26px 26px;overflow:hidden"
    >
      <span slot="tab">{a.tab}</span>

      <Paperclip color="#6b6275" style="top:-16px;right:40px;left:auto;transform:rotate(8deg)" />

      <div class="grid-2 reflect-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center">
        <div>
          <h2 class="h-display" style="color:#fff;font-size:clamp(30px, 4.2vw, 52px);margin:0">
            {a.h2a}{' '}
            <span
              class="swash"
              style="background:linear-gradient(135deg,#FCA45B,#A673F1);-webkit-background-clip:text;background-clip:text;color:transparent"
              >{a.h2b}</span
            >{' '}
            {a.h2c}
          </h2>
          <p style="font-size:18px;color:rgba(255,255,255,.72);max-width:480px;margin-top:16px">
            {a.sub}
          </p>

          <div style="display:flex;flex-direction:column;gap:14px;margin-top:28px">
            {
              modes.map((m, i) => (
                <div style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:16px 18px">
                  <span
                    style={`display:inline-block;font-size:13px;font-weight:800;color:${modeColors[i]};margin-bottom:5px`}
                  >
                    {m.tag}
                  </span>
                  <p style="margin:0;font-size:14.5px;color:rgba(255,255,255,.78);line-height:1.5">
                    {m.d}
                  </p>
                </div>
              ))
            }
          </div>

          <p style="font-size:13px;color:rgba(255,255,255,.5);margin-top:20px">{a.disclaimer}</p>
        </div>

        <div style="position:relative;display:grid;place-items:center">
          <div
            aria-hidden="true"
            style="position:absolute;border-radius:50%;filter:blur(46px);opacity:.4;background:#A673F1;width:330px;height:330px;inset:0;margin:auto"
          >
          </div>
          <PhoneShot
            src={reflectImg}
            alt="DailyMood — AI reflection screen"
            w={310}
            shadow="drop-shadow(0 44px 70px rgba(0,0,0,.5))"
            style="position:relative;z-index:5;transform:rotate(1.6deg)"
          />
        </div>
      </div>
    </Folder>
  </div>
</section>
