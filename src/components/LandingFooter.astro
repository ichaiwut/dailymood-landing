---
import { type Locale, getMessages, otherLocale, localeHref } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = getMessages(locale).landing;
const f = m.footer;
const n = m.nav;
const legalLinks = f.legalLinks as [string, string][];
const altLocale = otherLocale(locale);
const altHref = localeHref(altLocale);
const home = localeHref(locale);

const productLinks: [string, string][] = [
  [n.features, `${home}#features`],
  [n.ai, `${home}#ai`],
  [n.pricing, `${home}#pricing`],
];
---

<footer style="background:var(--plum);color:#fff;padding:64px 0 30px;position:relative;z-index:1">
  <div class="container">
    <div class="grid-3" style="display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:40px;margin-bottom:48px">
      <div>
        <div style="display:flex;align-items:center;gap:11px;margin-bottom:14px">
          <svg width="36" height="36" viewBox="0 0 32 32" aria-hidden="true">
            <defs>
              <linearGradient id="footer-mark" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#FCA45B"></stop>
                <stop offset="1" stop-color="#A673F1"></stop>
              </linearGradient>
            </defs>
            <rect x="2" y="2" width="28" height="28" rx="9" fill="url(#footer-mark)"></rect>
            <circle cx="12" cy="14" r="1.6" fill="#fff"></circle>
            <circle cx="20" cy="14" r="1.6" fill="#fff"></circle>
            <path d="M 11 20 Q 16 24 21 20" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round"></path>
          </svg>
          <span style="font-weight:800;font-size:22px">Dailymood</span>
        </div>
        <p style="color:rgba(255,255,255,.6);font-size:15px;max-width:300px;margin:0">{f.tag}</p>
      </div>

      <div>
        <div style="font-size:13px;font-weight:800;color:rgba(255,255,255,.55);text-transform:uppercase;letter-spacing:.06em;margin-bottom:16px">
          {f.productLabel}
        </div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:11px">
          {
            productLinks.map(([label, href]) => (
              <li>
                <a href={href} style="color:rgba(255,255,255,.85);text-decoration:none;font-size:15px">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <div style="font-size:13px;font-weight:800;color:rgba(255,255,255,.55);text-transform:uppercase;letter-spacing:.06em;margin-bottom:16px">
          {f.legalLabel}
        </div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:11px">
          {
            legalLinks.map(([name, href]) => (
              <li>
                <a href={href} style="color:rgba(255,255,255,.85);text-decoration:none;font-size:15px">
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div style="padding-top:26px;border-top:1px solid rgba(255,255,255,.1);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px">
      <div style="color:rgba(255,255,255,.5);font-size:13px">{f.copy}</div>
      <a
        href={altHref}
        style="padding:7px 14px;border-radius:100px;border:1px solid rgba(255,255,255,.18);background:transparent;color:#fff;font-family:var(--font);font-weight:800;font-size:13px;text-decoration:none"
      >
        🌐 {f.altLang} ↔
      </a>
    </div>
  </div>
</footer>
