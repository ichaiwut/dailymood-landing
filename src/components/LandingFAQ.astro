---
import Sticker from './paper/Sticker.astro';
import { type Locale, getMessages } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const f = getMessages(locale).landing.faq;
const items = f.items as { q: string; a: string }[];
---

<section id="faq" class="section" style="background:var(--desk-2)">
  <div
    class="container grid-2"
    style="display:grid;grid-template-columns:1fr 1.5fr;gap:56px;align-items:flex-start"
  >
    <div class="l-faq-sticky" style="position:sticky;top:100px">
      <span class="eyebrow">{f.eyebrow}</span>
      <h2 class="h-display" style="font-size:clamp(30px, 4vw, 48px);margin-top:18px">{f.title}</h2>
      <div style="position:relative;height:64px;margin-top:32px">
        <Sticker
          face="calm"
          color="var(--mint)"
          size={64}
          style="position:relative;top:0;transform:rotate(-8deg)"
        />
      </div>
    </div>

    <div class="faq-list">
      {
        items.map((it, i) => (
          <details class="faq-item sheet" open={i === 0}>
            <summary>
              <span>{it.q}</span>
              <span class="faq-mark" aria-hidden="true" />
            </summary>
            <div class="faq-answer">
              <p>{it.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-item {
    background: #fff;
    border-radius: 14px;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .faq-item > summary {
    list-style: none;
    cursor: pointer;
    padding: 20px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--font);
    font-weight: 800;
    font-size: 17px;
    color: var(--ink);
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-mark {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid var(--line);
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    position: relative;
  }
  .faq-mark::before,
  .faq-mark::after {
    content: '';
    position: absolute;
    background: var(--ink);
    transition: background 0.2s;
  }
  .faq-mark::before {
    width: 13px;
    height: 2px;
  }
  .faq-mark::after {
    width: 2px;
    height: 13px;
  }
  .faq-item[open] .faq-mark {
    background: var(--ink);
    border-color: var(--ink);
  }
  .faq-item[open] .faq-mark::before {
    background: #fff;
  }
  .faq-item[open] .faq-mark::after {
    display: none;
  }
  .faq-answer {
    padding: 0 22px 22px;
  }
  .faq-answer p {
    margin: 0;
    font-size: 15px;
    color: var(--ink-2);
    line-height: 1.6;
    max-width: 620px;
  }
</style>

<script>
  // One-open-at-a-time accordion behaviour.
  const list = document.querySelector('.faq-list');
  if (list) {
    list.addEventListener(
      'toggle',
      (e) => {
        const target = e.target as HTMLDetailsElement;
        if (!(target instanceof HTMLDetailsElement) || !target.open) return;
        list.querySelectorAll<HTMLDetailsElement>('details[open]').forEach((d) => {
          if (d !== target) d.open = false;
        });
      },
      true
    );
  }
</script>
