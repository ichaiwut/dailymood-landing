---
import CheckCircle from './CheckCircle.astro';
import Folder from './paper/Folder.astro';
import { type Locale, getMessages } from '@/lib/i18n';
import { loginHref, subscriptionHref } from '@/lib/cta';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = getMessages(locale).landing.pricing;
const freeFeats = p.freeFeats as string[];
const proFeats = p.proFeats as string[];
---

<section id="pricing" class="section">
  <div class="container">
    <div style="text-align:center;max-width:720px;margin:0 auto 52px">
      <span class="eyebrow">{p.eyebrow}</span>
      <h2 class="h-display" style="font-size:clamp(32px, 4.6vw, 56px);margin:18px 0 16px">
        {p.title}
      </h2>
      <p style="font-size:18px;color:var(--ink-2);margin:0 auto;max-width:560px">{p.sub}</p>
    </div>

    <div
      class="grid-2"
      style="display:grid;grid-template-columns:1fr 1fr;gap:22px;max-width:900px;margin:0 auto"
    >
      <!-- Free -->
      <Folder
        tabClass="mint"
        style="transform:rotate(-.8deg)"
        bodyStyle="padding:34px;border-radius:4px 20px 20px 20px;display:flex;flex-direction:column;gap:20px"
      >
        <span slot="tab">{p.freeName}</span>
        <div style="display:flex;align-items:baseline;gap:8px">
          <span class="h-display" style="font-size:54px">{p.freePrice}</span>
          <span style="color:var(--ink-3);font-size:15px;font-weight:700">{p.freePer}</span>
        </div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:11px;flex:1">
          {
            freeFeats.map((feat) => (
              <li style="display:flex;gap:10px;font-size:15px;align-items:flex-start">
                <CheckCircle />
                <span>{feat}</span>
              </li>
            ))
          }
        </ul>
        <a href={loginHref()} class="btn btn-ghost" style="width:100%">{p.freeCta}</a>
      </Folder>

      <!-- Pro -->
      <Folder
        tabClass="plum"
        style="transform:rotate(.8deg)"
        bodyStyle="padding:34px;border-radius:4px 20px 20px 20px;display:flex;flex-direction:column;gap:20px;background:linear-gradient(155deg,var(--plum-2),var(--plum));color:#fff"
      >
        <span slot="tab" style="display:inline-flex;align-items:center;gap:7px">
          {p.proName}
          <span style="font-size:11px;background:var(--peach);color:#fff;padding:2px 8px;border-radius:100px"
            >{p.proBadge}</span
          >
        </span>
        <div style="display:flex;align-items:baseline;gap:8px">
          <span class="h-display" style="font-size:54px;color:#fff">{p.proPrice}</span>
          <span style="color:rgba(255,255,255,.6);font-size:14px;font-weight:700">{p.proPer}</span>
        </div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:11px;flex:1">
          {
            proFeats.map((feat) => (
              <li style="display:flex;gap:10px;font-size:15px;align-items:flex-start;color:rgba(255,255,255,.92)">
                <span style="flex-shrink:0;margin-top:2px">
                  <CheckCircle fill="var(--peach)" />
                </span>
                <span>{feat}</span>
              </li>
            ))
          }
        </ul>
        <a href={subscriptionHref()} class="btn btn-peach" style="width:100%">{p.proCta}</a>
      </Folder>
    </div>
  </div>
</section>
