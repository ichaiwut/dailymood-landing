---
import Logo from './Logo.astro';
import { type Locale, getMessages, otherLocale, localeHref } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const n = getMessages(locale).landing.nav;
const altLocale = otherLocale(locale);
const altHref = localeHref(altLocale);

// Home base for the current locale. Used to prefix in-page anchors so they
// resolve from any sub-page (e.g. /cookies, /privacy) — clicking "AI" on
// /cookies should jump to "/#ai", not "/cookies#ai".
const home = localeHref(locale);
---

<nav id="landing-nav" data-scrolled="false">
  <div
    class="container"
    style="display:flex;align-items:center;justify-content:space-between;height:74px"
  >
    <a
      href={home}
      style="display:flex;align-items:center;text-decoration:none;color:var(--ink)"
      aria-label="DailyMood"
    >
      <Logo size={30} />
    </a>

    <div class="l-nav-links" style="display:flex;align-items:center;gap:28px">
      <a href={`${home}#features`} class="navlink">{n.features}</a>
      <a href={`${home}#ai`} class="navlink">{n.ai}</a>
      <a href={`${home}#pricing`} class="navlink">{n.pricing}</a>
      <a href={`${home}#faq`} class="navlink">{n.faq}</a>
    </div>

    <div style="display:flex;align-items:center;gap:12px">
      <a
        href={altHref}
        aria-label="Switch language"
        style="display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:100px;border:2px solid var(--ink);background:transparent;font-family:var(--font);font-weight:800;font-size:13px;cursor:pointer;color:var(--ink);text-decoration:none"
      >
        <span style={`opacity:${locale === 'th' ? 1 : 0.4}`}>TH</span>
        <span style="opacity:0.3">/</span>
        <span style={`opacity:${locale === 'en' ? 1 : 0.4}`}>EN</span>
      </a>
      <a
        href={`${home}#download`}
        class="btn btn-ink"
        style="height:44px;font-size:14px;padding:0 18px;border-radius:12px"
      >
        {n.download}
      </a>
    </div>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: all 0.25s ease;
  }
  nav[data-scrolled='true'] {
    background: rgba(247, 240, 228, 0.88);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    border-bottom-color: var(--line);
  }
  .navlink {
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    opacity: 0.85;
  }
  .navlink:hover {
    opacity: 1;
  }
</style>

<script>
  const nav = document.getElementById('landing-nav');
  if (nav) {
    const onScroll = () => {
      nav.dataset.scrolled = window.scrollY > 10 ? 'true' : 'false';
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
