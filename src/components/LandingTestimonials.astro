---
import Paperclip from './paper/Paperclip.astro';
import { type Locale, getMessages } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getMessages(locale).landing.testimonials;
const items = t.items as { q: string; n: string; r: string }[];

const cols = ['var(--peach)', 'var(--purple)', 'var(--mint)', 'var(--yellow)'];
---

<section class="section" style="background:var(--desk-2)">
  <div class="container">
    <div class="reveal" style="max-width:720px;margin:0 0 52px">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="h-display" style="font-size:clamp(32px, 4.6vw, 56px);margin-top:18px">{t.title}</h2>
    </div>

    <div class="grid-4 reveal" style="display:grid;grid-template-columns:repeat(4, 1fr);gap:18px">
      {
        items.map((it, i) => (
          <figure
            class="stacked"
            style={`margin:0;transform:translateY(${i % 2 ? 22 : 0}px) rotate(${(i % 2 ? 1 : -1) * 1}deg)`}
          >
            <div
              class="sheet"
              style="background:#fff;border-radius:14px;padding:34px 22px 22px;position:relative"
            >
              <Paperclip
                color="var(--clip)"
                style={`left:auto;right:22px;top:-15px;transform:rotate(${i % 2 ? 6 : -6}deg)`}
              />
              <blockquote style="margin:0;font-size:15px;line-height:1.55;color:var(--ink);font-weight:600">
                &ldquo;{it.q}&rdquo;
              </blockquote>
              <figcaption style="display:flex;align-items:center;gap:11px;padding-top:16px;margin-top:16px;border-top:1px solid var(--line)">
                <div
                  style={`width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,${cols[i % cols.length]},var(--lavender));display:grid;place-items:center;color:#fff;font-weight:800;font-size:15px`}
                >
                  {it.n.charAt(0)}
                </div>
                <div>
                  <div style="font-weight:800;font-size:13px">{it.n}</div>
                  <div style="font-size:11px;color:var(--ink-3)">{it.r}</div>
                </div>
              </figcaption>
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>
