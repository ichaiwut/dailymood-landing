---
import Folder from './paper/Folder.astro';
import { type Locale, getMessages } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const y = getMessages(locale).landing.year;
const months = y.months;

const palette = [
  'var(--peach)',
  'var(--yellow)',
  'var(--mint)',
  'var(--lavender)',
  'var(--blue)',
  'var(--purple)',
];

// Deterministic pixel colour for (month, day) — stable across builds/locales.
function cell(m: number, d: number): string | null {
  const key = (m * 31 + d * 7) % 100;
  if (key < 8) return null;
  if (key < 22) return palette[0];
  if (key < 38) return palette[1];
  if (key < 58) return palette[2];
  if (key < 72) return palette[3];
  if (key < 86) return palette[4];
  return palette[5];
}

const moodColors: { key: keyof typeof y.moods; color: string }[] = [
  { key: 'great', color: 'var(--peach)' },
  { key: 'good', color: 'var(--yellow)' },
  { key: 'okay', color: 'var(--mint)' },
  { key: 'meh', color: 'var(--lavender)' },
  { key: 'bad', color: 'var(--blue)' },
  { key: 'awful', color: 'var(--purple)' },
];
---

<section class="section">
  <div
    class="container grid-2"
    style="display:grid;grid-template-columns:1fr 1.4fr;gap:56px;align-items:center"
  >
    <div>
      <span class="eyebrow">{y.eyebrow}</span>
      <h2 class="h-display" style="font-size:clamp(30px, 4vw, 52px);margin:18px 0 16px">
        {y.title}
      </h2>
      <p style="font-size:18px;color:var(--ink-2);max-width:440px">{y.sub}</p>

      <div style="display:flex;gap:14px;margin-top:26px;flex-wrap:wrap">
        {
          moodColors.map((m) => (
            <div style="display:flex;align-items:center;gap:7px">
              <span style={`width:14px;height:14px;border-radius:4px;background:${m.color}`} />
              <span style="font-size:13px;font-weight:700;color:var(--ink-2)">{y.moods[m.key]}</span>
            </div>
          ))
        }
      </div>
    </div>

    <Folder
      tabClass="ink"
      clip
      style="transform:rotate(-.6deg)"
      bodyStyle="padding:30px;border-radius:4px 22px 22px 22px"
    >
      <span slot="tab">{y.cardYear}</span>

      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
        <span style="font-size:13px;font-weight:800;color:var(--ink-3)">{y.calendarLabel}</span>
        <span style="font-size:12px;color:var(--ink-3);font-weight:700">{y.cardDaysLogged}</span>
      </div>
      <div style="display:grid;grid-template-columns:auto minmax(0, 1fr);gap:7px">
        {
          months.map((label: string, mi: number) => (
            <>
              <div style="font-size:11px;font-weight:800;color:var(--ink-3);align-self:center;text-align:right;padding-right:4px">
                {label}
              </div>
              <div style="display:grid;grid-template-columns:repeat(31, minmax(0, 1fr));gap:3px;min-width:0">
                {Array.from({ length: 31 }).map((_, di) => {
                  const c = cell(mi, di);
                  return (
                    <div style={`aspect-ratio:1;border-radius:3px;background:${c || '#EFE7D8'};min-width:0`} />
                  );
                })}
              </div>
            </>
          ))
        }
      </div>
    </Folder>
  </div>
</section>
