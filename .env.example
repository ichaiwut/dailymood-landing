# Public app URL used for the web-app link + legacy CTAs (handled by src/lib/cta.ts).
PUBLIC_APP_URL=https://my.dailymood.me

# Native app store listing URLs for the download badges (src/lib/cta.ts).
# iOS is live — its URL is also the built-in default in cta.ts, so leaving this
# empty still links to the App Store. Android isn't published yet; leave it empty
# and its badge falls back to the in-page #download anchor.
PUBLIC_IOS_URL=https://apps.apple.com/th/app/id6778759803
PUBLIC_ANDROID_URL=

# Public landing URL used for canonical + OG + hreflang alternates.
PUBLIC_SITE_URL=https://dailymood.me

# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Loaded on every page load (PDPA informed-notice model — the banner notifies,
# tracking runs with anonymize_ip). Leave empty in development to disable GA.
PUBLIC_GA_ID=

# Google Ads conversion / remarketing tag ID (AW-XXXXXXXXX).
# Loaded alongside GA via the same gtag.js bootstrap. Disclosed in /cookies.
# Leave empty in development to disable Google Ads tracking.
PUBLIC_GADS_ID=

# Google Ads conversion LABEL for an App Store (iOS) install click — the part
# after the slash in a conversion's "AW-XXXXXXXXX/AbC-D_efGh" send_to id.
# A clicked App Store badge fires this Google Ads conversion (in addition to the
# GA4 download_click event). Needs PUBLIC_GADS_ID set too; leave either empty and
# no conversion is sent.
PUBLIC_GADS_DOWNLOAD_LABEL=

# Cloudflare Turnstile site key for the hero "try the AI" widget (anti-bot).
# When set, the widget renders a Turnstile challenge and sends its token to the
# app's /api/guest/analyze, which verifies it with TURNSTILE_SECRET_KEY (app repo).
# Both keys must be set for the bot check to be active. Leave empty to disable.
PUBLIC_TURNSTILE_SITE_KEY=
